{
  // ===== Models =====
  "Model: Base with integer id and audit": {
    "prefix": "qmodel",
    "scope": "prisma",
    "description": "Create a Prisma model with integer id and audit fields",
    "body": [
      "model ${1:model_name} {",
      "\t${2:id} Int @id @default(autoincrement())",
      "\t$0",
      "\t/// Audit fields",
      "\testado String @default(\"A\") @db.Char(1)",
      "\tfecha_creacion DateTime @default(now()) @db.Timestamptz()",
      "}"
    ]
  },
